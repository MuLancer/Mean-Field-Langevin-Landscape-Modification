    "    all_train_values.extend(tloss)\n",
    "    all_test_values.extend(eloss)\n",
    "\n",
    "colors_lm = plt.cm.Blues(np.linspace(0.5, 1, len(particle_counts)))    # 4 shades of blue\n",
    "colors_no_lm = plt.cm.Reds(np.linspace(0.5, 1, len(particle_counts)))  # 4 shades of red\n",
    "\n",
    "group_keys = []\n",
    "for method in methods:    \n",
    "    for avg_flag in avg_flags:\n",
    "        group_keys.append((method, avg_flag))\n",
    "\n",
    "# 1) Training Loss\n",
    "fig_train, axes_train = plt.subplots(nrows=2, ncols=2, figsize=(10, 10), \n",
    "                                     sharex=True, sharey=False)\n",
    "axes_train = axes_train.flatten()\n",
    "fig_train.suptitle(\"Training Loss\", fontsize=16)\n",
    "\n",
    "for idx, (method, avg_flag) in enumerate(group_keys):\n",
    "    ax = axes_train[idx]\n",
    "\n",
    "    for i, nP in enumerate(particle_counts):\n",
    "        # LM\n",
    "        train_losses_lm, _, _ = results[(method, True, avg_flag, nP)]\n",
    "        # NoLM\n",
    "        train_losses_no_lm, _, _ = results[(method, False, avg_flag, nP)]\n",
    "\n",
    "        ax.plot(train_losses_lm, color=colors_lm[i], \n",
    "                label=f\"LM, nP={nP}\" if i==0 else None)\n",
    "        ax.plot(train_losses_no_lm, color=colors_no_lm[i], \n",
    "                label=f\"NoLM, nP={nP}\" if i==0 else None)\n",
    "\n",
    "    method_str = method.upper()\n",
    "    grad_str = \"Avg grad\" if avg_flag else \"Indiv grad\"\n",
    "    ax.set_title(f\"{method_str}-{grad_str}\")\n",
    "    ax.grid(True)\n",
    "\n",
    "axes_train[0].legend()\n",
    "\n",
    "plt.tight_layout(rect=[0, 0, 1, 0.95])  \n",
    "plt.show()\n",
    "\n",
    "# 2) Test Loss\n",
    "fig_test, axes_test = plt.subplots(nrows=2, ncols=2, figsize=(10, 10), \n",
    "                                   sharex=True, sharey=False)\n",
    "axes_test = axes_test.flatten()\n",
    "fig_test.suptitle(\"Test Loss\", fontsize=16)\n",
    "\n",
    "for idx, (method, avg_flag) in enumerate(group_keys):\n",
    "    ax = axes_test[idx]\n",
    "\n",
    "    for i, nP in enumerate(particle_counts):\n",
    "        # LM\n",
    "        _, test_losses_lm, _ = results[(method, True, avg_flag, nP)]\n",
    "        # NoLM\n",
    "        _, test_losses_no_lm, _ = results[(method, False, avg_flag, nP)]\n",
    "\n",
    "        ax.plot(test_losses_lm, color=colors_lm[i],\n",
    "                label=f\"LM, nP={nP}\" if i==0 else None)\n",
    "        ax.plot(test_losses_no_lm, color=colors_no_lm[i], \n",
    "                label=f\"NoLM, nP={nP}\" if i==0 else None)\n",
    "\n",
