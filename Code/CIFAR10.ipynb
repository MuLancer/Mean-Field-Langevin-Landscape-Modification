    "import torch\n",
    "import torch.nn as nn\n",
    "import torchvision\n",
    "import torchvision.transforms as transforms\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import copy\n",
    "from torchvision.models import vit_l_16, ViT_L_16_Weights\n",
    "\n",
    "############################################\n",
    "# Setup\n",
    "############################################\n",
    "torch.manual_seed(0)\n",
    "np.random.seed(0)\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(device)\n",
    "\n",
    "############################################\n",
    "# Dataset\n",
    "############################################\n",
    "transform = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),  # ViT requires 224x224 input\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize((0.4914, 0.4822, 0.4465), (0.247, 0.243, 0.261))\n",
    "])\n",
    "train_dataset = torchvision.datasets.CIFAR10(root='./data', train=True, transform=transform, download=True)\n",
    "test_dataset = torchvision.datasets.CIFAR10(root='./data', train=False, transform=transform, download=True)\n",
    "train_loader = torch.utils.data.DataLoader(dataset=train_dataset, batch_size=32, shuffle=True)\n",
    "test_loader = torch.utils.data.DataLoader(dataset=test_dataset, batch_size=256, shuffle=False)\n",
    "\n",
    "############################################\n",
    "# ViT-L/16 Model\n",
    "############################################\n",
    "def get_vit_model():\n",
    "    weights = ViT_L_16_Weights.IMAGENET1K_V1\n",
    "    model = vit_l_16(weights=weights)\n",
    "    model.heads.head = nn.Linear(model.heads.head.in_features, 10)\n",
    "    return model\n",
    "\n",
    "############################################\n",
    "# Evaluation Functions\n",
    "############################################\n",
    "def evaluate_loss(models, loader):\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    total_loss, total_count = 0.0, 0\n",
    "    with torch.no_grad():\n",
    "        for images, labels in loader:\n",
    "            images, labels = images.to(device), labels.to(device)\n",
    "            outputs_sum = sum(m(images) for m in models)\n",
    "            outputs_avg = outputs_sum / len(models)\n",
    "            loss = criterion(outputs_avg, labels).item()\n",
    "            total_loss += loss * images.size(0)\n",
    "            total_count += images.size(0)\n",
    "    return total_loss / total_count\n",
    "\n",
    "def evaluate_accuracy(models, loader):\n",
    "    correct, total = 0, 0\n",
    "    with torch.no_grad():\n",
    "        for images, labels in loader:\n",
    "            images, labels = images.to(device), labels.to(device)\n",
    "            outputs_sum = sum(m(images) for m in models)\n",
    "            outputs_avg = outputs_sum / len(models)\n",
    "            _, predicted = torch.max(outputs_avg, 1)\n",
    "            correct += (predicted == labels).sum().item()\n",
    "            total += labels.size(0)\n",
    "    return 100.0 * correct / total\n",
    "\n",
    "############################################\n",
    "# Particle Update Function\n",
    "############################################\n",
    "def particle_update(model, images, labels, optimizer, c_k, f_func=lambda x: x, epsilon=1.0):\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    optimizer.zero_grad()\n",
    "    outputs = model(images)\n",
    "    loss = criterion(outputs, labels)\n",
    "    loss.backward()\n",
    "\n",
    "    denom = f_func(max(0.0, loss.item() - c_k)) + epsilon\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for param in model.parameters():\n",
    "            if param.grad is not None:\n",
    "                param.grad.data /= denom\n",
    "    optimizer.step()\n",
    "\n",
    "    return loss.item()\n",
    "\n",
    "############################################\n",
    "# Main Experiment Runner\n",
    "############################################\n",
    "def run_particle_experiment(num_particles=3, num_epochs=5, lr=5e-5, f_func=lambda x: x, epsilon=1.0):\n",
    "    models = [get_vit_model().to(device) for _ in range(num_particles)]\n",
    "\n",
    "    optimizers = [torch.optim.AdamW(m.parameters(), lr=lr) for m in models]\n",
    "\n",
    "    train_losses, test_losses = [], []\n",
    "\n",
    "    for epoch in range(num_epochs):\n",
    "        epoch_loss_sum = 0.0\n",
    "\n",
    "        for images, labels in train_loader:\n",
    "            images, labels = images.to(device), labels.to(device)\n",
    "\n",
    "            losses = [nn.functional.cross_entropy(m(images), labels).item() for m in models]\n",
    "            c_k = np.mean(losses)\n",
    "\n",
    "            batch_loss = 0.0\n",
    "            for i, m in enumerate(models):\n",
    "                batch_loss += particle_update(m, images, labels, optimizers[i], c_k, f_func, epsilon)\n",
    "\n",
    "            epoch_loss_sum += batch_loss / num_particles\n",
    "\n",
    "        train_loss_epoch = epoch_loss_sum / len(train_loader)\n",
    "        train_losses.append(train_loss_epoch)\n",
    "        test_loss = evaluate_loss(models, test_loader)\n",
    "        test_losses.append(test_loss)\n",
    "\n",
    "        print(f\"Epoch {epoch+1}/{num_epochs}: Train Loss = {train_loss_epoch:.4f}, Test Loss = {test_loss:.4f}\")\n",
    "\n",
    "    acc = evaluate_accuracy(models, test_loader)\n",
    "    print(f\"Final Test Accuracy: {acc:.2f}%\")\n",
    "\n",
    "    plt.figure(figsize=(10,5))\n",
    "    plt.plot(train_losses, label='Train Loss')\n",
    "    plt.plot(test_losses, label='Test Loss')\n",
    "    plt.xlabel('Epoch')\n",
    "    plt.ylabel('Loss')\n",
    "    plt.title('ViT-L/16 Training and Test Loss')\n",
    "    plt.legend()\n",
    "    plt.grid()\n",
    "    plt.show()\n",
    "\n",
    "run_particle_experiment()"
   ]
